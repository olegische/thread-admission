{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["owner_id", "thread_id", "revision", "sha256"],
  "properties": {
    "owner_id": { "type": "string" },
    "thread_id": { "type": "string" },
    "revision": { "type": "string" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
